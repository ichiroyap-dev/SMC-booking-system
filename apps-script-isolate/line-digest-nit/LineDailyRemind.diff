+function normalizeIdPunctuation_(text) {
+  var s = String(text || "");
+  s = s.replace(/；/g, ";");
+  s = s.replace(/[、，]/g, ",");
+  s = s.replace(/（/g, "(");
+  s = s.replace(/）/g, ")");
+  s = s.replace(/：/g, ": ");
+  s = s.replace(/。/g, ". ");
+  s = s.replace(/！/g, "! ");
+  s = s.replace(/？/g, "? ");
+  s = s.replace(/;(?!\s)/g, "; ");
+  s = s.replace(/,(?!\s|\d{3}(?:\D|$))/g, ", ");
+  s = s.replace(/([^\s(])\(/g, "$1 (");
+  s = s.replace(/\)([^\s),.;!?])/g, ") $1");
+  s = s.replace(/[ \t]{2,}/g, " ");
+  return s.replace(/^\s+|\s+$/g, "");
