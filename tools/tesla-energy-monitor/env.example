# Copy this file to `.env` on the ops computer. Never commit `.env`.
# 複製成 `.env` 放在操作電腦上。絕對不要把 `.env` 上傳到 GitHub。

# --- Tesla Fleet API ---
TESLA_FLEET_CLIENT_ID=
TESLA_FLEET_CLIENT_SECRET=

# Option A: tokens in env (refresh token will rotate; JSON file is safer)
TESLA_ACCESS_TOKEN=
TESLA_REFRESH_TOKEN=

# Option B (recommended): local JSON path the tool can update after refresh
# TESLA_TOKENS_JSON=/home/ops/secrets/tesla-tokens.json

# 水美土雞城 energy site — override only if Tesla assigned a new id
TESLA_ENERGY_SITE_ID=2534007359185439

# Region host (NA default; change if Tesla support says otherwise)
TESLA_FLEET_API_BASE=https://fleet-api.prd.na.vn.cloud.tesla.com

# Token refresh host. Tesla's current Fleet docs also mention:
#   https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token
TESLA_TOKEN_URL=https://auth.tesla.com/oauth2/v3/token

# Target spreadsheet (SMC Tesla 能源動態監測)
TESLA_SHEET_ID=1wYslB5UNTLc_Cy3DsdD4Zly9ZmDDY_8qu3UfVvvm0WA

# --- Google Sheets ---
# Path to the service-account JSON key downloaded from Google Cloud.
# Share the spreadsheet with that service account email as Editor.
GOOGLE_APPLICATION_CREDENTIALS=/home/ops/secrets/smc-sheets-service-account.json
